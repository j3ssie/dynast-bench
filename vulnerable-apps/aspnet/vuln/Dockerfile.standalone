# The build context with its answer-key comments blanked out
# (dynast-bench/tools/annotations/strip.mjs). Every COPY of app files below
# reads from this stage, never from the raw context.
FROM --platform=$BUILDPLATFORM node:22-bookworm-slim AS dynast-src
COPY --from=dynast-annotations strip.mjs /opt/dynast/strip.mjs
COPY . /src
RUN node /opt/dynast/strip.mjs /src

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY --from=dynast-src /src/BenchAspNet.csproj ./
RUN --mount=type=cache,target=/root/.nuget/packages dotnet restore
COPY --from=dynast-src /src/ ./
RUN --mount=type=cache,target=/root/.nuget/packages dotnet publish -c Release -o /out --no-restore
FROM mcr.microsoft.com/dotnet/aspnet:8.0-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates nodejs && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /out ./
COPY --from=dynast-src /src/entrypoint.standalone.sh /app/entrypoint.standalone.sh
COPY --from=dynast-src /src/internal-sink.mjs /app/internal-sink.mjs
RUN chmod +x /app/entrypoint.standalone.sh && mkdir -p /data/uploads /data/files && printf 'public report\n' > /data/files/readme.txt
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=5s --retries=30 --start-period=60s CMD curl -sf http://localhost:3000/api/_verify/health || exit 1
ENTRYPOINT ["/app/entrypoint.standalone.sh"]
