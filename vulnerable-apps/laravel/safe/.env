APP_NAME=BenchBoard
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:13311

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Planted CWE-798: a real APP_KEY committed to source (enables cookie/decrypt forgery).
APP_KEY=base64:cS7zd9Bz/H1RaBcSOg98LJEtVTKPXoYgO7WuA4cIGgU=

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=bench
DB_USERNAME=bench
DB_PASSWORD=bench

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="board@bench.local"
MAIL_FROM_NAME="${APP_NAME}"

VERIFY_TOKEN=benchsecret

VITE_APP_NAME="${APP_NAME}"
