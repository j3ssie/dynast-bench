# All-in-one image: origin + nginx + apache + traefik in one container, each on a
# distinct internal port (8080/8081/8082). Same buggy configs as compose; only the
# listen ports are patched at start. `make solo` publishes the three ports.

# The build context with its answer-key comments blanked out
# (dynast-bench/tools/annotations/strip.mjs). Every COPY of app files below
# reads from this stage, never from the raw context.
FROM --platform=$BUILDPLATFORM node:22-bookworm-slim AS dynast-src
COPY --from=dynast-annotations strip.mjs /opt/dynast/strip.mjs
COPY . /src
RUN node /opt/dynast/strip.mjs /src

FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends nginx apache2 curl ca-certificates \
 && a2enmod proxy proxy_http headers >/dev/null \
 && rm -rf /var/lib/apt/lists/*

COPY --from=traefik:v3.1 /usr/local/bin/traefik /usr/local/bin/traefik

COPY --from=dynast-src /src/origin/server.mjs /app/origin/server.mjs
COPY --from=dynast-src /src/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=dynast-src /src/apache/proxy-bench.conf /etc/apache2/conf-enabled/proxy-bench.conf
COPY --from=dynast-src /src/traefik/traefik.yml /etc/traefik/traefik.yml
COPY --from=dynast-src /src/traefik/dynamic.yml /etc/traefik/dynamic.yml
COPY --from=dynast-src /src/entrypoint.standalone.sh /usr/local/bin/entrypoint.standalone.sh
RUN chmod +x /usr/local/bin/entrypoint.standalone.sh

EXPOSE 8080 8081 8082
HEALTHCHECK --interval=10s --timeout=5s --retries=30 --start-period=30s \
  CMD curl -sf http://localhost:8080/api/_verify/health || exit 1
CMD ["/usr/local/bin/entrypoint.standalone.sh"]
