<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" version="6.0">
  <display-name>JSP Benchmark</display-name>
  <filter><filter-name>charset</filter-name><filter-class>bench.filter.CharsetFilter</filter-class></filter>
  <filter-mapping><filter-name>charset</filter-name><url-pattern>/*</url-pattern></filter-mapping>
  <filter><filter-name>auth</filter-name><filter-class>bench.filter.AuthFilter</filter-class></filter>
  <filter-mapping><filter-name>auth</filter-name><url-pattern>/*</url-pattern></filter-mapping>

  <servlet><servlet-name>login</servlet-name><servlet-class>bench.web.LoginServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>login</servlet-name><url-pattern>/login</url-pattern></servlet-mapping>
  <servlet><servlet-name>logout</servlet-name><servlet-class>bench.web.LogoutServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>logout</servlet-name><url-pattern>/logout</url-pattern></servlet-mapping>
  <servlet><servlet-name>verify</servlet-name><servlet-class>bench.web.VerifyApiServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>verify</servlet-name><url-pattern>/api/_verify/*</url-pattern></servlet-mapping>
  <servlet><servlet-name>search</servlet-name><servlet-class>bench.web.SearchServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>search</servlet-name><url-pattern>/search</url-pattern></servlet-mapping>
  <servlet><servlet-name>posts</servlet-name><servlet-class>bench.web.PostServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>posts</servlet-name><url-pattern>/post</url-pattern></servlet-mapping>
  <servlet><servlet-name>reports</servlet-name><servlet-class>bench.web.ReportServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>reports</servlet-name><url-pattern>/report</url-pattern></servlet-mapping>
  <servlet><servlet-name>upload</servlet-name><servlet-class>bench.web.UploadServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>upload</servlet-name><url-pattern>/upload</url-pattern></servlet-mapping>
  <servlet><servlet-name>import</servlet-name><servlet-class>bench.web.ImportServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>import</servlet-name><url-pattern>/import</url-pattern></servlet-mapping>
  <servlet><servlet-name>fetch</servlet-name><servlet-class>bench.web.FetchServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>fetch</servlet-name><url-pattern>/fetch</url-pattern></servlet-mapping>
  <servlet><servlet-name>export</servlet-name><servlet-class>bench.web.ExportServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>export</servlet-name><url-pattern>/export</url-pattern></servlet-mapping>
  <servlet><servlet-name>download</servlet-name><servlet-class>bench.web.DownloadServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>download</servlet-name><url-pattern>/download</url-pattern></servlet-mapping>
  <servlet><servlet-name>admin</servlet-name><servlet-class>bench.web.AdminServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>admin</servlet-name><url-pattern>/admin/*</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>admin</servlet-name><url-pattern>/manage/users</url-pattern></servlet-mapping>
  <servlet><servlet-name>manager</servlet-name><servlet-class>bench.web.ManagerServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>manager</servlet-name><url-pattern>/manager/html</url-pattern></servlet-mapping>
  <servlet><servlet-name>profile</servlet-name><servlet-class>bench.web.ProfileServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>profile</servlet-name><url-pattern>/profile</url-pattern></servlet-mapping>
  <servlet><servlet-name>jwt</servlet-name><servlet-class>bench.web.JwtServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>jwt</servlet-name><url-pattern>/api/jwt/me</url-pattern></servlet-mapping>
  <servlet><servlet-name>reset</servlet-name><servlet-class>bench.web.ResetServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>reset</servlet-name><url-pattern>/reset</url-pattern></servlet-mapping>
  <servlet><servlet-name>comments</servlet-name><servlet-class>bench.web.CommentServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>comments</servlet-name><url-pattern>/comments</url-pattern></servlet-mapping>
  <servlet><servlet-name>internal</servlet-name><servlet-class>bench.web.InternalServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>internal</servlet-name><url-pattern>/internal/admin</url-pattern></servlet-mapping>
  <servlet><servlet-name>crypto</servlet-name><servlet-class>bench.web.CryptoServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>crypto</servlet-name><url-pattern>/crypto</url-pattern></servlet-mapping>
  <servlet><servlet-name>billing</servlet-name><servlet-class>bench.web.BillingServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>billing</servlet-name><url-pattern>/billing/seats</url-pattern></servlet-mapping>
  <servlet><servlet-name>invite</servlet-name><servlet-class>bench.web.InviteServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>invite</servlet-name><url-pattern>/invite</url-pattern></servlet-mapping>
  <servlet><servlet-name>captcha</servlet-name><servlet-class>bench.web.CaptchaServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>captcha</servlet-name><url-pattern>/captcha</url-pattern></servlet-mapping>
  <servlet><servlet-name>err</servlet-name><servlet-class>bench.web.ErrorDemoServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>err</servlet-name><url-pattern>/error-demo</url-pattern></servlet-mapping>

  <welcome-file-list><welcome-file>index.jsp</welcome-file></welcome-file-list>
</web-app>
