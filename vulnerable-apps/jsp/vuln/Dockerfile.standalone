# The build context with its answer-key comments blanked out
# (dynast-bench/tools/annotations/strip.mjs). Every COPY of app files below
# reads from this stage, never from the raw context.
FROM --platform=$BUILDPLATFORM node:22-bookworm-slim AS dynast-src
COPY --from=dynast-annotations strip.mjs /opt/dynast/strip.mjs
COPY . /src
RUN node /opt/dynast/strip.mjs /src

FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /src
COPY --from=dynast-src /src/pom.xml .
RUN --mount=type=cache,target=/root/.m2 mvn -q -DskipTests dependency:go-offline
COPY --from=dynast-src /src/src ./src
RUN --mount=type=cache,target=/root/.m2 mvn -q -DskipTests package

FROM tomcat:10.1-jre21-temurin
RUN apt-get update && apt-get install -y --no-install-recommends postgresql postgresql-contrib nodejs curl && rm -rf /var/lib/apt/lists/*
RUN rm -rf /usr/local/tomcat/webapps/*
COPY --from=build /src/target/ROOT.war /usr/local/tomcat/webapps/ROOT.war
COPY --from=dynast-src /src/db/init /docker-entrypoint-initdb.d
COPY --from=dynast-src /src/internal-sink.mjs /internal-sink.mjs
COPY --from=dynast-src /src/entrypoint.standalone.sh /entrypoint.standalone.sh
RUN chmod +x /entrypoint.standalone.sh
EXPOSE 3000
ENTRYPOINT ["/entrypoint.standalone.sh"]
