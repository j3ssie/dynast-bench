FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /src
COPY pom.xml .
RUN mvn -q -DskipTests dependency:go-offline
COPY src ./src
RUN mvn -q -DskipTests package

FROM tomcat:10.1-jre21-temurin
RUN apt-get update && apt-get install -y --no-install-recommends postgresql postgresql-contrib nodejs curl && rm -rf /var/lib/apt/lists/*
RUN rm -rf /usr/local/tomcat/webapps/*
COPY --from=build /src/target/ROOT.war /usr/local/tomcat/webapps/ROOT.war
COPY db/init /docker-entrypoint-initdb.d
COPY internal-sink.mjs /internal-sink.mjs
COPY entrypoint.standalone.sh /entrypoint.standalone.sh
RUN chmod +x /entrypoint.standalone.sh
EXPOSE 3000
ENTRYPOINT ["/entrypoint.standalone.sh"]
