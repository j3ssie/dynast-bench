generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  seatsLimit  Int          @default(5)
  seatsUsed   Int          @default(0)
  premium     Boolean      @default(false)
  users       User[]
  posts       Post[]
  invitations Invitation[]
  memberships Membership[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  displayName  String    @default("")
  role         String    @default("user")
  isAdmin      Boolean   @default(false)
  verified     Boolean   @default(true)
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  resetToken   String?
  resetExpires DateTime?
  /// Bumped whenever the user's role or memberships change; a session minted
  /// under an older value is meant to be dead.
  sessionVersion Int     @default(0)
  posts        Post[]
  comments     Comment[]
  memberships  Membership[]
  createdAt    DateTime  @default(now())
}

/// A user's seat in a workspace. A user's home org (User.orgId) has an active
/// row; asking to join another org creates a pending one that an admin of that
/// org approves. The session carries whichever org the user switched into.
model Membership {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id])
  role      String       @default("user")
  /// pending | active
  status    String       @default("pending")
  createdAt DateTime     @default(now())

  @@unique([userId, orgId])
}

model Post {
  id        String    @id @default(cuid())
  title     String
  slug      String    @unique
  body      String
  /// draft -> in_review -> approved -> published. Only an editor who is not the
  /// author can move a post from in_review to approved.
  status    String    @default("draft")
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id])
  comments  Comment[]
  createdAt DateTime  @default(now())
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

/// An in-progress registration. The wizard writes one row on step 1 and carries
/// its id across the remaining steps, so the server holds the flow state rather
/// than trusting the client to.
model SignupDraft {
  /// Sequential rather than a cuid, so a draft is addressable by counting.
  id          Int      @id @default(autoincrement())
  email       String
  code        String
  verified    Boolean  @default(false)
  displayName String   @default("")
  role        String   @default("user")
  orgSlug     String   @default("acme")
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Invitation {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id])
  email     String
  role      String   @default("user")
  token     String
  createdAt DateTime @default(now())
}
