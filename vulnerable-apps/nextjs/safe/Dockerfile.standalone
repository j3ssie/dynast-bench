# All-in-one image: Postgres + Redis + internal sink + the app, in one container.
#   docker build -f Dockerfile.standalone -t vuln-nextjs .
#   docker run --rm -p 3000:3000 vuln-nextjs
# No docker-compose required. Behaviour is identical to the compose topology
# (service names are aliased to localhost at startup).
FROM node:22-bookworm-slim

ENV NEXT_TELEMETRY_DISABLED=1
# Dummy URL for build only (all data-touching routes/pages are force-dynamic).
ENV DATABASE_URL=postgresql://build:build@localhost:5432/build

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      openssl ca-certificates curl postgresql redis-server \
 && rm -rf /var/lib/apt/lists/*
ENV PATH="/usr/lib/postgresql/15/bin:${PATH}"

WORKDIR /app
COPY package.json ./
RUN npm install
COPY . .
RUN npx prisma generate && npm run build

EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=5s --retries=30 --start-period=120s \
  CMD curl -sf http://localhost:3000/api/_verify/health || exit 1
CMD ["sh", "/app/entrypoint.standalone.sh"]
