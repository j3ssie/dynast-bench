FROM node:22-bookworm-slim AS deps
WORKDIR /src
COPY package.json tsconfig.json ./
RUN npm install
COPY src ./src
RUN npm run build

FROM node:22-bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends postgresql postgresql-contrib ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=production
COPY package.json ./
RUN npm install --omit=dev
COPY --from=deps /src/dist ./dist
COPY entrypoint.standalone.sh /app/entrypoint.standalone.sh
COPY internal-sink.mjs /app/internal-sink.mjs
RUN chmod +x /app/entrypoint.standalone.sh
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=5s --retries=30 --start-period=90s \
  CMD curl -sf http://127.0.0.1:3000/api/_verify/health || exit 1
CMD ["/app/entrypoint.standalone.sh"]
