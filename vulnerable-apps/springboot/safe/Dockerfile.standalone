FROM maven:3.9.8-eclipse-temurin-21 AS build
WORKDIR /src
COPY pom.xml .
RUN mvn -q -DskipTests dependency:go-offline
COPY src ./src
RUN mvn -q -DskipTests package
FROM eclipse-temurin:21-jre
RUN apt-get update && apt-get install -y --no-install-recommends postgresql postgresql-contrib nodejs curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /src/target/springboot-benchmark-0.1.0.jar /app/app.jar
COPY uploads /app/uploads
COPY secrets /app/secrets
COPY internal-sink.mjs /app/internal-sink.mjs
COPY entrypoint.standalone.sh /app/entrypoint.standalone.sh
RUN chmod +x /app/entrypoint.standalone.sh
EXPOSE 3000
ENTRYPOINT ["/app/entrypoint.standalone.sh"]
