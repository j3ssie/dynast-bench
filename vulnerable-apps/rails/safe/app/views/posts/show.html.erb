<!doctype html>
<html>
  <head><title><%= @post.title %></title></head>
  <body>
    <h1><%= @post.title %></h1>
    <article><%= @post.body %></article>
    <section id="comments">
      <% @post.comments.each do |comment| %>
        <div class="comment"><%= comment.body %></div> <!-- SAFE XSS-STORED-001: stored comment is escaped -->
      <% end %>
    </section>
  </body>
</html>
