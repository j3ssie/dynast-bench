# --- secrets / local env ---
.env
*.env.local
!.env.example
# ...except an app's own .env, which is part of the app under test rather than a
# developer's local secret. laravel plants DEBUG-001 (APP_DEBUG=true) and a
# committed APP_KEY in exactly that file, and SECRET-001 IS a .env backup served
# from the web root. Ignoring them made a fresh clone ship neither bug.
# Guarded by dynast-bench/test/tracked.test.ts.
!vulnerable-apps/*/vuln/.env
!vulnerable-apps/*/safe/.env
!vulnerable-apps/*/vuln/**/.env.backup

# --- scanner output & scoring artifacts (not checked in) ---
# Unanchored on purpose: a scan dropped anywhere in the tree stays out.
findings.json
findings/
scores/
*.sarif

# ...except examples/, which ships deliberate fixtures with those exact names.
# They are checked in and asserted by dynast-bench/test/examples.test.ts.
!examples/**

# --- Node / bench tooling ---
node_modules/
bench/dist/
# `make build` output (compiled CLI binary)
dynast-bench/dist/
*.tsbuildinfo

# --- per-stack build artifacts ---
# Python
__pycache__/
*.pyc
.venv/
# Java / Maven / Gradle
target/
build/
*.war
*.class
# .NET  (`bin/` is build output — but unanchored it also swallowed Rails'
# binstubs, and rails/entrypoint.sh runs `bin/rails db:prepare` at boot, so a
# fresh clone built an image whose container exited before Puma started.)
**/bin/Debug/
**/bin/Release/
obj/
# Ruby
vendor/bundle/
# Go
*.exe

# --- docker / volumes leftovers ---
*.pid

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
